# Request-scoped queries: restricted role, subject to Row-Level Security (created by `npm run db:rls`)
DATABASE_URL="postgresql://rms_app:rms_app@localhost:5432/rms"
# Login, tenant resolution, seeding: table owner (bypasses RLS). Never used to serve tenant data.
SYSTEM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rms"
# Prisma CLI (migrate / db execute)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rms"

# openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
PORT=3000
